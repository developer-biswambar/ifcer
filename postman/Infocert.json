{
  "info": {
    "name": "InfoCert Signature API - mTLS",
    "_postman_id": "infocert-signature-mtls",
    "description": "Postman collection for InfoCert Signature API using mTLS endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://mtlsapitest.infocert.digital/signature/v1"
    },
    {
      "key": "certificateId",
      "value": ""
    },
    {
      "key": "authType",
      "value": "SMSP"
    },
    {
      "key": "transactionId",
      "value": ""
    },
    {
      "key": "signerId",
      "value": ""
    },
    {
      "key": "bearerToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Info",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/info"
      }
    },
    {
      "name": "Certificates - List",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bearerToken}}"
          },
          {
            "key": "X-signer-id",
            "value": "{{signerId}}"
          }
        ],
        "url": "{{baseUrl}}/certificates"
      }
    },
    {
      "name": "Certificate - Get",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bearerToken}}"
          },
          {
            "key": "X-signer-id",
            "value": "{{signerId}}"
          }
        ],
        "url": "{{baseUrl}}/certificates/{{certificateId}}"
      }
    },
    {
      "name": "Certificate Chain",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bearerToken}}"
          },
          {
            "key": "X-signer-id",
            "value": "{{signerId}}"
          }
        ],
        "url": "{{baseUrl}}/certificates/{{certificateId}}/chain"
      }
    },
    {
      "name": "Authenticators",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bearerToken}}"
          },
          {
            "key": "X-signer-id",
            "value": "{{signerId}}"
          }
        ],
        "url": "{{baseUrl}}/authenticators"
      }
    },
    {
      "name": "Challenge",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bearerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-signer-id",
            "value": "{{signerId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scope\": \"signature\"\n}"
        },
        "url": "{{baseUrl}}/authenticators/{{authType}}/challenge"
      }
    },
    {
      "name": "Authorize Signature",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bearerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-signer-id",
            "value": "{{signerId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"transactionId\": \"{{transactionId}}\",\n  \"otp\": \"123456\"\n}"
        },
        "url": "{{baseUrl}}/authenticators/{{certificateId}}/{{authType}}/authorize"
      }
    },
    {
      "name": "Sign Document",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bearerToken}}"
          },
          {
            "key": "X-signer-id",
            "value": "{{signerId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"applicationId\": \"demo-app\",\n  \"authorization\": {\n    \"transactionId\": \"{{transactionId}}\",\n    \"otp\": \"123456\"\n  }\n}"
        },
        "url": "{{baseUrl}}/certificates/{{certificateId}}/sign"
      }
    },
    {
      "name": "OneShot Sign",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bearerToken}}"
          },
          {
            "key": "X-signer-id",
            "value": "{{signerId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"applicationId\": \"demo-app\"\n}"
        },
        "url": "{{baseUrl}}/oneshot/sign"
      }
    },
    {
      "name": "Multi Sign",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bearerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"signerData\": []\n}"
        },
        "url": "{{baseUrl}}/multi/sign"
      }
    }
  ]
}