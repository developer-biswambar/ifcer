# Application Configuration
APP_NAME=IFCER Batch Service
LOG_LEVEL=INFO

# AWS Configuration
# Note: AWS credentials are automatically provided by the IAM role attached to the ECS task
# No need to configure AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY
AWS_REGION=eu-south-1
S3_BUCKET_NAME=your-bucket-name
DYNAMODB_TABLE_NAME=ifcer-certifications
# Optional: Auto-delete certification records after N days (for compliance/retention)
# DYNAMODB_TTL_DAYS=365

# InfoCert API Configuration (mTLS)
# InfoCert's Manifest-Based Hash Signature API
# Certificates are stored in S3 and loaded during application startup
#
# ENVIRONMENTS:
#   STAGE:      https://mtlsapistage.infocert.digital/signature/v1
#   PRODUCTION: https://mtlsapi.infocert.digital/signature/v1
#
# Use STAGE for testing, PRODUCTION for live operations
VENDOR_API_URL=https://mtlsapistage.infocert.digital/signature/v1

# Your InfoCert Credential ID (X-signer-id header)
# Example: MA0001
INFOCERT_CREDENTIAL_ID=your-infocert-credential-id

# mTLS Certificate Configuration
#
# OPTION 1: Use P12 file directly (recommended - simpler setup)
# Upload your P12 file to S3 and configure:
#   aws s3 cp your_cert.p12 s3://YOUR-BUCKET/certs/client_cert.p12
# Then set:
VENDOR_MTLS_P12_S3_KEY=certs/client_cert.p12
VENDOR_MTLS_P12_PASSWORD=your-p12-password

# OPTION 2: Use PEM files (if you already extracted them)
# Extract P12 to PEM format first: ./scripts/extract_p12_to_pem.sh
# Then upload to S3 and configure:
# VENDOR_MTLS_CERT_S3_KEY=certs/client_cert.pem
# VENDOR_MTLS_KEY_S3_KEY=certs/client_key.pem
# VENDOR_MTLS_CA_S3_KEY=certs/ca_bundle.pem
#
# Note: If VENDOR_MTLS_P12_S3_KEY is set, it takes precedence over PEM files

# Processing Configuration
HASH_ALGORITHM=sha256
BATCH_SIZE=100
REQUEST_TIMEOUT=30
