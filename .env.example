# Application Configuration
APP_NAME=IFCER Batch Service
LOG_LEVEL=INFO

# AWS Configuration
# Note: AWS credentials are automatically provided by the IAM role attached to the ECS task
# No need to configure AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY
AWS_REGION=eu-south-1
S3_BUCKET_NAME=your-bucket-name
DYNAMODB_TABLE_NAME=ifcer-certifications
# Optional: Auto-delete certification records after N days (for compliance/retention)
# DYNAMODB_TTL_DAYS=365

# Vendor API Configuration (mTLS)
VENDOR_API_URL=https://vendor-api.example.com
VENDOR_MTLS_CERT_PATH=/certs/client_cert.pem
VENDOR_MTLS_KEY_PATH=/certs/client_key.pem
VENDOR_MTLS_CA_PATH=/certs/ca_bundle.pem

# Processing Configuration
HASH_ALGORITHM=sha256
BATCH_SIZE=100
REQUEST_TIMEOUT=30
